{
    "name": "@godexture/js",
    "version": "1.0.0",
    "description": "JavaScript/TypeScript bindings for godexture",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "bun build:wasm && bun build:ts",
        "build:ts": "tsc -p tsconfig.app.json",
        "build:wasm": "bun run scripts/build.ts",
        "test": "bun run ./test"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "@types/node": "26.1.1",
        "typescript": "7.0.2"
    }
}
