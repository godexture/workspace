{
    "name": "@godexture/js",
    "version": "0.0.4",
    "description": "JavaScript/TypeScript bindings for godexture",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/godexture/bindings.git",
        "directory": "js"
    },
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "licenses",
        "LICENSE"
    ],
    "scripts": {
        "build": "bun build:wasm && bun build:ts",
        "build:ts": "tsc -p tsconfig.app.json",
        "build:wasm": "bun run scripts/build.ts",
        "test": "bun run ./test"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "@types/node": "26.1.1",
        "typescript": "7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
